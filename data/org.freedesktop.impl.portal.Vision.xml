<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.impl.portal.Vision:
      @short_description: Local vision model backend interface
  -->
  <interface name="org.freedesktop.impl.portal.Vision">
    <!--
        GetUseCaseAvailability:
        @app_id: Application ID of the caller
        @use_case: One of the supported ``vision.*`` task tokens
        @availability: Struct containing is_available, a stable availability status code, and human-readable reason

        Returns whether a local profile is assigned and runnable for @use_case.
    -->
    <method name="GetUseCaseAvailability">
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="use_case" direction="in"/>
      <arg type="(bss)" name="availability" direction="out"/>
    </method>

    <!--
        CreateSession:
        @handle: Request handle owned by the frontend
        @session_handle: Session handle allocated by the frontend
        @app_id: Application ID of the caller
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @use_case: Supported vision task token
        @instructions: Stable system instructions for this session

        The session @use_case selects which vision operation is permitted for
        the session. Create separate sessions for different vision tasks.
    -->
    <method name="CreateSession">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="use_case" direction="in"/>
      <arg type="s" name="instructions" direction="in"/>
    </method>

    <!--
        Prewarm:
        @handle: Request handle owned by the frontend
        @session_handle: Vision session handle returned by CreateSession

        Optionally starts the container for the session's assigned profile before
        the first user-visible operation. First inference starts the runtime on
        demand if Prewarm is skipped. Prewarm does not prepare a specific stream
        method or request payload.
    -->
    <method name="Prewarm">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
    </method>

    <!--
        StreamDescribe:
        @handle: Request handle owned by the frontend
        @session_handle: A ``vision.describe`` session handle returned by CreateSession
        @image_fd: Readable, sealable memfd containing PNG or JPEG image bytes.
        @instructions: Optional per-image instructions for this request.
        @options: Vision options struct

        Natural-language image description tokens are emitted as
        VisionTextReceived signals while this call is in progress.
    -->
    <method name="StreamDescribe">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="h" name="image_fd" direction="in"/>
      <arg type="s" name="instructions" direction="in"/>
      <arg type="(s)" name="options" direction="in"/>
    </method>

    <!--
        StreamOcr:
        @handle: Request handle owned by the frontend
        @session_handle: A ``vision.ocr`` session handle returned by CreateSession
        @image_fd: Readable, sealable memfd containing PNG or JPEG image bytes.
        @instructions: Optional per-image instructions for this request.
        @options: Vision options struct

        Text extracted from the image is emitted as VisionTextReceived signals
        while this call is in progress.
    -->
    <method name="StreamOcr">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="h" name="image_fd" direction="in"/>
      <arg type="s" name="instructions" direction="in"/>
      <arg type="(s)" name="options" direction="in"/>
    </method>

    <!--
        StreamDetect:
        @handle: Request handle owned by the frontend
        @session_handle: A ``vision.detect`` session handle returned by CreateSession
        @image_fd: Readable, sealable memfd containing PNG or JPEG image bytes.
        @instructions: Optional per-image instructions for this request.
        @options: Vision options struct

        Detected objects are emitted as VisionDetectionsReceived signals.
    -->
    <method name="StreamDetect">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="h" name="image_fd" direction="in"/>
      <arg type="s" name="instructions" direction="in"/>
      <arg type="(s)" name="options" direction="in"/>
    </method>

    <!--
        StreamSegment:
        @handle: Request handle owned by the frontend
        @session_handle: A ``vision.segment`` session handle returned by CreateSession
        @image_fd: Readable, sealable memfd containing PNG or JPEG image bytes.
        @instructions: Optional per-image instructions for this request.
        @options: Vision segmentation options struct

        Masks are emitted as VisionMasksReceived signals.
    -->
    <method name="StreamSegment">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="h" name="image_fd" direction="in"/>
      <arg type="s" name="instructions" direction="in"/>
      <arg type="(sa(ddb)a(dddd))" name="options" direction="in"/>
    </method>

    <!--
        StreamDepth:
        @handle: Request handle owned by the frontend
        @session_handle: A ``vision.depth`` session handle returned by CreateSession
        @image_fd: Readable, sealable memfd containing PNG or JPEG image bytes.
        @instructions: Optional per-image instructions for this request.
        @options: Vision options struct

        Depth maps are emitted as VisionDepthReceived signals.
    -->
    <method name="StreamDepth">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="h" name="image_fd" direction="in"/>
      <arg type="s" name="instructions" direction="in"/>
      <arg type="(s)" name="options" direction="in"/>
    </method>

    <signal name="ModelLoading">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <arg type="s" name="message"/>
    </signal>

    <signal name="VisionTextReceived">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <arg type="s" name="text"/>
      <arg type="b" name="done"/>
    </signal>

    <signal name="VisionDetectionsReceived">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out2" value="QList&lt;std::tuple&lt;QString,double,double,double,double,double&gt;&gt;"/>
      <arg type="a(sddddd)" name="detections"/>
      <arg type="b" name="done"/>
    </signal>

    <signal name="VisionMasksReceived">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <arg type="a(sdddddsii)" name="masks"/>
      <arg type="b" name="done"/>
    </signal>

    <signal name="VisionDepthReceived">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <arg type="(iiadsdd)" name="depth"/>
      <arg type="b" name="done"/>
    </signal>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
